font.family: serif
font.serif: TeX Gyre Termes, Noto Serif KR
font.size: 9
mathtext.fontset: stix
axes.labelsize: 9
axes.linewidth: 0.6
axes.grid: False
axes.spines.top: True
axes.spines.right: True
axes.spines.bottom: True
axes.spines.left: True
axes.facecolor: white
axes.prop_cycle: cycler('color', ['0072B2', 'D55E00', '009E73', 'CC79A7', 'E69F00', '56B4E9', 'F0E442', '000000'])
xtick.direction: out
ytick.direction: out
xtick.top: False
ytick.right: False
xtick.bottom: True
ytick.left: True
xtick.labelsize: 9
ytick.labelsize: 9
xtick.major.width: 0.6
ytick.major.width: 0.6
lines.linewidth: 1
lines.markersize: 3
legend.fontsize: 8
legend.frameon: False
figure.facecolor: white
figure.figsize: 3.3858267717, 2.6
savefig.facecolor: white
savefig.dpi: 600
pdf.fonttype: 42
ps.fonttype: 42
svg.fonttype: path
